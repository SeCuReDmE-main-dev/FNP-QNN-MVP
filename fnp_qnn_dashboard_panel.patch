+}
+
+.button-row {
+  margin-top: 14px;
+}
+
+.button-row.compact {
+  margin-top: 0;
+}
+
+.terminal,
+.json-box {
+  overflow: auto;
+  max-height: 420px;
+  margin: 14px 0 0;
+  padding: 16px;
+  border: 1px solid var(--line);
