+
+input:focus,
+textarea:focus {
+  border-color: rgba(112, 225, 245, 0.72);
+  box-shadow: 0 0 0 4px rgba(112, 225, 245, 0.08);
+}
+
+.button {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-height: 42px;
+  padding: 0 16px;
+  border: 1px solid transparent;
+  border-radius: 999px;
