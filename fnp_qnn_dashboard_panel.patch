+:root {
+  color-scheme: dark;
+  --bg: #07111f;
+  --bg-soft: #0d1b2d;
+  --panel: rgba(18, 32, 52, 0.82);
+  --panel-strong: rgba(22, 39, 65, 0.94);
+  --line: rgba(157, 185, 224, 0.18);
+  --text: #eef6ff;
+  --muted: #9fb4cd;
+  --accent: #70e1f5;
+  --accent-strong: #89f7c1;
+  --warning: #ffd166;
+  --danger: #ff6b8a;
+  --shadow: 0 24px 80px rgba(0, 0, 0, 0.32);
+  --radius: 24px;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+html {
+  min-height: 100%;
+  background:
+    radial-gradient(circle at 15% 10%, rgba(112, 225, 245, 0.22), transparent 32rem),
+    radial-gradient(circle at 85% 0%, rgba(137, 247, 193, 0.14), transparent 28rem),
+    linear-gradient(135deg, #05101e 0%, var(--bg) 46%, #091528 100%);
+}
+
+body {
+  min-height: 100%;
+  margin: 0;
+  color: var(--text);
+  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+}
+
+button,
+input,
+textarea {
+  font: inherit;
+}
+
+.shell {
+  width: min(1480px, calc(100% - 40px));
+  margin: 0 auto;
+  padding: 28px 0 48px;
+}
+
+.panel {
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  background: var(--panel);
+  box-shadow: var(--shadow);
+  backdrop-filter: blur(18px);
+}
+
+.hero {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: 28px;
+  padding: 34px;
+  overflow: hidden;
+  position: relative;
+}
+
+.hero::after {
+  content: "";
+  position: absolute;
+  inset: auto -80px -160px auto;
+  width: 420px;
+  height: 420px;
+  border-radius: 999px;
+  background: radial-gradient(circle, rgba(112, 225, 245, 0.22), transparent 68%);
+  pointer-events: none;
+}
+
+.hero h1 {
+  margin: 4px 0 12px;
+  font-size: clamp(2.2rem, 5vw, 4.7rem);
+  line-height: 0.92;
+  letter-spacing: -0.07em;
+}
+
+.hero-copy {
+  max-width: 780px;
+  margin: 0;
+  color: var(--muted);
+  font-size: 1.02rem;
+  line-height: 1.7;
+}
+
+.hero-actions,
+.button-row,
+.chip-row {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 10px;
+}
+
+.safety {
+  margin-top: 16px;
+  padding: 16px 20px;
+  color: #ffe8b0;
+  background: rgba(255, 209, 102, 0.08);
+}
+
+.layout {
+  display: grid;
+  grid-template-columns: minmax(360px, 0.9fr) minmax(520px, 1.4fr);
+  gap: 18px;
+  margin-top: 18px;
+}
+
+.left-column,
+.right-column {
+  display: grid;
+  align-content: start;
+  gap: 18px;
+}
+
+.status-panel,
+.controls-panel,
