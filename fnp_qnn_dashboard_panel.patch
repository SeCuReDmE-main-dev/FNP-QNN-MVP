+  background: rgba(137, 247, 193, 0.09);
+}
+
+.pill.busy {
+  color: #c2edff;
+  border-color: rgba(112, 225, 245, 0.42);
+  background: rgba(112, 225, 245, 0.09);
+}
+
+.pill.error,
+.chip.error {
+  color: #ffd2dc;
+  border-color: rgba(255, 107, 138, 0.42);
+  background: rgba(255, 107, 138, 0.09);
+}
+
+.control-grid {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 12px;
+  margin-bottom: 16px;
+}
+
+label,
+.payload-label {
+  display: grid;
+  gap: 7px;
+  color: var(--muted);
+  font-size: 0.82rem;
+  font-weight: 700;
+}
+
+.checkbox-row {
+  display: flex;
+  align-items: center;
+  min-height: 64px;
+  padding: 12px;
+  border: 1px solid var(--line);
+  border-radius: 16px;
+  background: rgba(255, 255, 255, 0.035);
