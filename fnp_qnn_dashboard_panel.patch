+}
+
+.button.primary {
+  color: #06111d;
+  background: linear-gradient(135deg, var(--accent) 0%, var(--accent-strong) 100%);
+}
+
+.button.secondary {
+  border-color: rgba(112, 225, 245, 0.35);
